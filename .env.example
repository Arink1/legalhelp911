# Server-side only. Set these in Vercel project settings for Production
# (and Preview if you want test deploys to write leads).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legal News article generation (weekly cron + manual triggers)
ANTHROPIC_API_KEY=sk-ant-...
# Vercel sends this as "Authorization: Bearer <value>" on cron invocations;
# use the same value yourself to call the cron and admin endpoints manually.
CRON_SECRET=generate-a-long-random-string
# Optional: override the model (default claude-opus-5)
# ARTICLE_MODEL=claude-opus-5
# Optional: skip human review and publish generated articles immediately
# AUTO_PUBLISH_ARTICLES=true
